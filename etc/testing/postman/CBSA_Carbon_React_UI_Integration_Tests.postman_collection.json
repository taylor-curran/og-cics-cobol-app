        {
          "name": "Create Customer - Valid Age (25 years)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const today = new Date();",
                  "const birthYear = today.getFullYear() - 25;",
                  "const dateOfBirth = `${birthYear}-06-15`;",
                  "pm.collectionVariables.set('validDateOfBirth', dateOfBirth);",
                  "",
                  "const randomNum = Math.floor(Math.random() * 10000);",
                  "const customerName = `Mr Test Customer ${randomNum}`;",
                  "pm.collectionVariables.set('testCustomerName', customerName);"
                ],
                "type": "text/javascript"
              }
