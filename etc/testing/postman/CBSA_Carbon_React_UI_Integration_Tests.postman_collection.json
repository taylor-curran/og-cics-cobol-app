      "name": "User Story 3 - Create Accounts with 10-Account Limit",
      "item": [
        {
          "name": "Create Account - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response contains account details', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('accountType');",
                  "    pm.collectionVariables.set('firstAccountId', jsonData.id);",
                  "});",
                  "",
                  "pm.test('Account is linked to correct customer', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var expectedCustomerNumber = pm.collectionVariables.get('customerNumber');",
                  "    pm.expect(jsonData.customerNumber).to.eql(expectedCustomerNumber);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerNumber\": \"{{customerNumber}}\",\n  \"sortCode\": \"{{sortCode}}\",\n  \"accountType\": \"SAVING\",\n  \"interestRate\": \"1.5\",\n  \"overdraft\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/account",
              "host": ["{{baseUrl}}"],
              "path": ["account"]
            }
          },
          "response": []
        },
        {
          "name": "Create 9 More Accounts (Total 10)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const customerNumber = pm.collectionVariables.get('customerNumber');",
                  "const sortCode = pm.collectionVariables.get('sortCode');",
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "",
                  "let accountsCreated = 1;",
                  "const maxAccounts = 9;",
                  "",
                  "const accountTypes = ['CURRENT', 'SAVING', 'LOAN', 'MORTGAGE', 'ISA'];",
                  "",
                  "function createAccount(index) {",
                  "    return new Promise((resolve, reject) => {",
                  "        const accountType = accountTypes[index % accountTypes.length];",
                  "        ",
                  "        pm.sendRequest({",
                  "            url: `${baseUrl}/account`,",
                  "            method: 'POST',",
                  "            header: {",
                  "                'Content-Type': 'application/json'",
                  "            },",
                  "            body: {",
                  "                mode: 'raw',",
                  "                raw: JSON.stringify({",
                  "                    customerNumber: customerNumber,",
                  "                    sortCode: sortCode,",
                  "                    accountType: accountType,",
                  "                    interestRate: '1.0',",
                  "                    overdraft: 0",
                  "                })",
                  "            }",
                  "        }, (err, res) => {",
                  "            if (err) {",
                  "                console.log(`Error creating account ${index + 2}:`, err);",
                  "                reject(err);",
                  "            } else {",
                  "                console.log(`Account ${index + 2} created with status:`, res.code);",
                  "                resolve(res);",
                  "            }",
                  "        });",
                  "    });",
                  "}",
                  "",
                  "async function createMultipleAccounts() {",
                  "    for (let i = 0; i < maxAccounts; i++) {",
                  "        await createAccount(i);",
                  "    }",
                  "}",
                  "",
                  "createMultipleAccounts().then(() => {",
                  "    console.log('Successfully created 9 more accounts (total 10)');",
                  "}).catch(err => {",
                  "    console.error('Failed to create accounts:', err);",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Pre-request script completed account creation', function () {",
                  "    console.log('9 additional accounts created via pre-request script');",
                  "    console.log('Total accounts for customer should now be 10');",
                  "    pm.expect(true).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/account/retrieveByCustomerNumber/{{customerNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["account", "retrieveByCustomerNumber", "{{customerNumber}}"]
            }
          },
          "response": []
        },
